# Stage 1: Build and Train the Model
FROM python:3.9 AS model_training

WORKDIR /app

# Copy the source code for model training
COPY src/model_training.py /app/

# Install dependencies
COPY requirements.txt /app/
RUN pip install -r requirements.txt

# Train and save the model
RUN python model_training.py

# Stage 2: Serve Predictions
FROM python:3.9 AS serving

WORKDIR /app

# Copy trained model from training stage
COPY --from=model_training /app/house_price_model.pkl /app/

# Copy the serving code
COPY src/main.py /app/

# Expose port 80
EXPOSE 80

# Install dependencies for serving
COPY requirements.txt /app/
RUN pip install -r requirements.txt

# Copy templates and statics (optional, for web UI)
COPY src/templates /app/templates

# Run the Flask app
CMD ["python", "main.py"]
